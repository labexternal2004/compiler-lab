#include<stdio.h>
#include<ctype.h>

char s[100];
int i=0,error=0;

void E();
void T();
void F();

void E()
{
    T();
    while(s[i]=='+'&& !error)
    {
        i++;
        T();
    }
}

void T()
{
    F();
    while(s[i]=='*'&& !error)
    {
        i++;
        F();
    }
}

void F()
{
    if(isalnum(s[i]))
        i++;
    else if(s[i]=='(')
    {
        i++;
        E();
        if(s[i]==')')
            i++;
        else
            error=1;
    }
    else
        error=1;
}

int main()
{
    printf("Enter expression: ");
    scanf("%s",s);
    E();
    if(s[i]!='\0')
        error=1;

    if(error)
        printf("Rejected\n");
    else
        printf("Accepted\n");

    return 0;
}
