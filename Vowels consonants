%{
#include <stdio.h>
int vowels = 0, consonants = 0;
%}

%%
[aeiouAEIOU] { vowels++; }
[a-zA-Z] { consonants++; }
. ;
\n ;
%%

int main()
{
    printf("Enter a string: ");
    yylex();

    printf("\nTotal vowels = %d", vowels);
    printf("\nTotal consonants = %d\n", consonants);

    return 0;
}

int yywrap()
{
    return 1;
}
