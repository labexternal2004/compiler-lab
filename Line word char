

%{
#include <stdio.h>
int lines = 0, words = 0, chars = 0;
%}

%%
\n { lines++; chars++; }
[ \t]+ { chars += yyleng; }
[^ \t\n]+ { words++; chars += yyleng; }
%%

int main()
{
    printf("Enter the text:\n");
    yylex();

    printf("\nNumber of lines = %d", lines);
    printf("\nNumber of words = %d", words);
    printf("\nNumber of characters = %d\n", chars);

    return 0;
}

int yywrap()
{
    return 1;
}
