
%{
#include<stdio.h>
%}

%%
"int"|"float"|"char"|"if"|"else"|"while" {
    printf("\nKeyword: %s", yytext);
}

[a-zA-Z_][a-zA-Z0-9_]* {
    printf("\nIdentifier: %s", yytext);
}

[0-9]+ {
    printf("\nNumber: %s", yytext);
}

"+"|"-"|"*"|"/"|"=" {
    printf("\nOperator: %s", yytext);
}

[;(),{}] {
    printf("\nSpecial Symbol: %s", yytext);
}

[ \t\n]+ ;

. {
    printf("\nUnknown: %s", yytext);
}
%%

int main()
{
    printf("Enter a program:\n");
    yylex();
    return 0;
}

int yywrap()
{
    return 1;
}
